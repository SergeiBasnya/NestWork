DATABASE_URL=postgresql://nestwork:nestwork@localhost:5432/nestwork_dev

# Distinct local-development placeholders. Replace them in every shared or
# production environment with independently generated secrets of 32+ chars.
JWT_SECRET=local-only-access-secret-change-before-sharing-0001
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-sharing-0002

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
REFRESH_COOKIE_SAME_SITE=lax
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000

CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

SEED_USER1_EMAIL=owner@example.test
SEED_USER1_NAME=Owner
SEED_USER1_PASSWORD=local-owner-password-change-me
SEED_USER2_EMAIL=member@example.test
SEED_USER2_NAME=Member
SEED_USER2_PASSWORD=local-member-password-change-me

# ─── Server (apps/server/.env) ───────────────────────────
# Neon Postgres — use the POOLED endpoint (host contains "-pooler") in prod.
DATABASE_URL=postgresql://nestwork:nestwork@localhost:5432/nestwork_dev

# JWT — must be set, distinct, and ≥ 32 chars (enforced at boot in production).
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-different-refresh-secret-minimum-32-chars

PORT=4000
NODE_ENV=development

# Allowed web origin(s), comma-separated (prod + Vercel previews).
CLIENT_ORIGIN=http://localhost:3000

# WebRTC TURN relay (Cloudflare dashboard → Realtime → TURN → create a key).
# Leave empty to serve STUN only — calls work on friendly networks but have no
# relay fallback for strict NAT / firewalls / some mobile networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional: short access-token TTL for testing socket expiry (default 15m).
# ACCESS_TTL=40s
# Optional: pg pool size (default 5).
# DB_POOL_MAX=5

# Seed only: mandatory credentials; passwords must be distinct and at least 12 chars.
SEED_USER1_EMAIL=owner@example.test
SEED_USER1_NAME=Propriétaire
SEED_USER1_PASSWORD=replace-with-a-strong-unique-password
SEED_USER2_EMAIL=member@example.test
SEED_USER2_NAME=Membre
SEED_USER2_PASSWORD=replace-with-another-strong-password
# Production seed requires this explicit one-shot acknowledgement.
# ALLOW_PRODUCTION_SEED=true

# ─── Web (apps/web/.env.local) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Adresse qui reçoit les candidatures au pilote depuis la page d'accueil.
NEXT_PUBLIC_PILOT_EMAIL=contact@nestwork.site
# Optional separate Socket.IO origin. Production defaults to the validated API
# origin (wss); if API_URL is absent in prod CSP falls back to https://api.nestwork.site.
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Optional: proactive token refresh interval in ms (default 13min).
# NEXT_PUBLIC_TOKEN_REFRESH_MS=780000

# Note: NestWork keeps realtime state in memory (no Redis needed today).
# Render requires NODE_VERSION=22 (pnpm 11.3 needs Node ≥ 22.13).

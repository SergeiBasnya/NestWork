{
  "name": "nestwork",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "predev": "pnpm --filter @nestwork/shared build",
    "dev": "concurrently -n web,server -c blue,green \"pnpm --filter @nestwork/web dev\" \"pnpm --filter @nestwork/server dev\"",
    "build": "pnpm --filter @nestwork/shared build && pnpm --filter @nestwork/server build && pnpm --filter @nestwork/web build",
    "lint": "eslint . --ext .ts,.tsx",
    "public:export": "node scripts/export-public.mjs",
    "public:check": "node scripts/check-public-export.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.24",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
